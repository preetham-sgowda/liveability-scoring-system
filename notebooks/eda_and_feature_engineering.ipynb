 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Liveability Scoring System - EDA and Feature Engineering\n",
    "\n",
    "This notebook explores the features in `mart_ward_features`, handles missing values, visualizes distributions and correlations, and computes Moran's I spatial autocorrelation for Bengaluru wards."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import geopandas as gpd\n",
    "import libpysal\n",
    "import esda\n",
    "from splot.esda import plot_moran, moran_scatterplot\n",
    "from shapely import wkt\n",
    "\n",
    "import sys\n",
    "import os\n",
    "sys.path.insert(0, os.path.abspath('..'))\n",
    "from scripts.db_utils import get_db_connection\n",
    "\n",
    "plt.style.use('ggplot')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Data\n",
    "\n",
    "We load `mart_ward_features` from PostgreSQL."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "try:\n",
    "    with get_db_connection() as conn:\n",
    "        df = pd.read_sql(\"SELECT * FROM marts.mart_ward_features\", conn)\n",
    "        # The geom comes as WKB, we convert to geopandas later if needed\n",
    "    print(f\"Loaded {len(df)} rows from PostgreSQL.\")\n",
    "except Exception as e:\n",
    "    print(f\"Could not load from DB: {e}\")\n",
    "    # Fallback to CSV\n",
    "    df = pd.read_csv('../data/processed/ward_features_enriched.csv')\n",
    "    print(f\"Loaded {len(df)} rows from CSV.\")\n",
    "\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Missingness Heatmap"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(15, 8))\n",
    "sns.heatmap(df.isnull(), cbar=False, cmap='viridis')\n",
    "plt.title('Missingness Heatmap (Yellow = Missing)')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Correlation Matrix"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()\n",
    "# Exclude IDs\n",
    "numeric_cols = [c for c in numeric_cols if c not in ['ward_id', 'ward_number', 'year', 'cluster_id']]\n",
    "\n",
    "corr = df[numeric_cols].corr()\n",
    "plt.figure(figsize=(20, 16))\n",
    "sns.heatmap(corr, cmap='coolwarm', center=0, annot=False, linewidths=.5)\n",
    "plt.title('Feature Correlation Matrix')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Feature Distributions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "features_to_plot = ['crime_rate_per_1000', 'avg_aqi', 'avg_ndvi', 'resolution_rate', 'median_price_sqft']\n",
    "\n",
    "fig, axes = plt.subplots(len(features_to_plot), 1, figsize=(10, 4*len(features_to_plot)))\n",
    "for i, col in enumerate(features_to_plot):\n",
    "    if col in df.columns:\n",
    "        sns.histplot(df[col].dropna(), kde=True, ax=axes[i], color='teal')\n",
    "        axes[i].set_title(f'Distribution of {col}')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Spatial Autocorrelation (Moran's I)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_moran(df, latest_year):\n",
    "    # We need geometry.\n",
    "    if 'geom' not in df.columns:\n",
    "        print(\"No geometry found, skipping spatial autocorrelation.\")\n",
    "        return\n",
    "        \n",
    "    df_latest = df[df['year'] == latest_year].copy()\n",
    "    # Convert to GeoDataFrame\n",
    "    df_latest['geometry'] = gpd.GeoSeries.from_wkb(df_latest['geom'], crs=\"EPSG:4326\")\n",
    "    gdf = gpd.GeoDataFrame(df_latest, geometry='geometry')\n",
    "    \n",
    "    # Impute NaNs for target features\n",
    "    for col in ['crime_rate_per_1000', 'avg_aqi', 'avg_ndvi']:\n",
    "        gdf[col] = gdf[col].fillna(gdf[col].median())\n",
    "        \n",
    "    # Compute spatial weights (Queen contiguity)\n",
    "    w = libpysal.weights.Queen.from_dataframe(gdf)\n",
    "    w.transform = 'r'\n",
    "    \n",
    "    for col in ['crime_rate_per_1000', 'avg_aqi', 'avg_ndvi']:\n",
    "        y = gdf[col].values\n",
    "        moran = esda.Moran(y, w)\n",
    "        print(f\"Global Moran's I for {col}: {moran.I:.3f} (p-value: {moran.p_sim:.3f})\")\n",
    "        \n",
    "        # Plot\n",
    "        fig, ax = plt.subplots(figsize=(6, 6))\n",
    "        moran_scatterplot(moran, ax=ax)\n",
    "        ax.set_xlabel(col)\n",
    "        ax.set_ylabel(f'Spatial Lag of {col}')\n",
    "        plt.title(f\"Moran Scatterplot - {col}\")\n",
    "        plt.show()\n",
    "\n",
    "if 'year' in df.columns:\n",
    "    run_moran(df, df['year'].max())\n"
   ]
  }
 ]
}
